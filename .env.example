# Supabase project settings: https://supabase.com/dashboard/project/_/settings/api
# Use the legacy anon key (starts with "eyJ...", under "Project API keys"), not the
# newer "publishable" key (starts with "sb_publishable_...") — @supabase/supabase-js
# 2.111.0 rejects the new format with "Invalid API key".
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# OpenAI API key for Whisper voice-memo transcription in the Journal card.
# Server-only — do NOT prefix with NEXT_PUBLIC_, it must never reach the browser.
# https://platform.openai.com/api-keys
OPENAI_API_KEY=

# Anthropic API key for parsing freeform workout descriptions in the Weight
# Training card. Server-only — do NOT prefix with NEXT_PUBLIC_.
# https://console.anthropic.com/settings/keys
ANTHROPIC_API_KEY=

# Google OAuth client for the Upcoming Events card (Calendar API, read-only).
# From a Google Cloud project with the Calendar API enabled. Both are
# server-only. The redirect URI registered in Google Cloud Console must be
# exactly <your-deployed-origin>/api/auth/callback/google.
# https://console.cloud.google.com/apis/credentials
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Todoist API token for the Today's Tasks card. Server-only. Find it under
# Settings → Integrations → Developer in the Todoist app.
TODOIST_API_TOKEN=
