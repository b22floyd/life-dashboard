# Supabase project settings: https://supabase.com/dashboard/project/_/settings/api
# Use the legacy anon key (starts with "eyJ...", under "Project API keys"), not the
# newer "publishable" key (starts with "sb_publishable_...") — @supabase/supabase-js
# 2.111.0 rejects the new format with "Invalid API key".
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# OpenAI API key for Whisper voice-memo transcription in the Journal card.
# Server-only — do NOT prefix with NEXT_PUBLIC_, it must never reach the browser.
# https://platform.openai.com/api-keys
OPENAI_API_KEY=

# Anthropic API key for parsing freeform workout descriptions in the Weight
# Training card. Server-only — do NOT prefix with NEXT_PUBLIC_.
# https://console.anthropic.com/settings/keys
ANTHROPIC_API_KEY=

# Google OAuth client for the Upcoming Events card (Calendar API, read-only).
# From a Google Cloud project with the Calendar API enabled. Both are
# server-only. The redirect URI registered in Google Cloud Console must be
# exactly <your-deployed-origin>/api/auth/callback/google.
# https://console.cloud.google.com/apis/credentials
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Todoist API token for the Today's Tasks card. Server-only. Find it under
# Settings → Integrations → Developer in the Todoist app.
TODOIST_API_TOKEN=

# Whoop OAuth client for the Health card (recovery, sleep, strain). Both are
# server-only. The redirect URI registered in the Whoop Developer Dashboard
# must be exactly <your-deployed-origin>/api/auth/callback/whoop.
# https://developer.whoop.com/
WHOOP_CLIENT_ID=
WHOOP_CLIENT_SECRET=

# Service-role key for the weekly backup cron job (/api/cron/backup), which
# runs with no signed-in session and needs to bypass RLS to read your data
# and write into the private "backups" Storage bucket. Server-only — NEVER
# prefix with NEXT_PUBLIC_ or expose this to the browser, it has full
# database access. Under Project Settings → API → Project API keys.
SUPABASE_SERVICE_ROLE_KEY=

# Shared secret authorizing the scheduled cron jobs (/api/cron/backup and
# /api/cron/push-reminders). Generate any random string (e.g. `openssl rand
# -hex 32`) and set the same value here and as a Vercel project environment
# variable — Vercel automatically sends it as `Authorization: Bearer
# <value>` when invoking scheduled Cron Jobs, which is how those routes
# tell a real cron invocation apart from anyone else hitting the URL.
CRON_SECRET=

# VAPID key pair authenticating this app's daily push reminders (Settings →
# Notifications) to browser push services — no third-party account needed,
# generate your own pair locally with:
#   npx web-push generate-vapid-keys
# The public key is safe to expose to the browser (it's how the browser
# proves a subscription to *your* server specifically); the private key is
# server-only and must never be prefixed with NEXT_PUBLIC_. VAPID_SUBJECT
# must be a "mailto:" URI — push services use it to contact you if your
# server is misbehaving. All three are optional: with any of them unset,
# the Notifications section just shows "not configured" instead of erroring.
NEXT_PUBLIC_VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:you@example.com
